#!/bin/bash
# Daily Now baslatici.
#
# Sunucu zaten calisiyorsa yalnizca tarayiciyi acar; calismiyorsa serve.py'yi
# on planda calistirir. Uygulama Dock'ta durdugu surece sunucu ayaktadir;
# Dock ikonuna sag tiklayip cikinca sunucu da kapanir.

PORT=8123
URL="http://localhost:$PORT/"

# Proje klasoru: normalde .app'in yaninda durur. Baska bir yere tasinmis ya da
# takma ad yerine kopyalanmissa bilinen konuma duseriz.
APP="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT="$(dirname "$APP")"
if [ ! -f "$PROJECT/serve.py" ]; then
  PROJECT="/Users/mertkarabiber/Desktop/Proje/DailyNews"
fi

die() {
  /usr/bin/osascript -e "display alert \"Daily Now acilamadi\" message \"$1\" as critical" >/dev/null 2>&1
  exit 1
}

[ -f "$PROJECT/serve.py" ] || die "serve.py bulunamadi. Aranan yer: $PROJECT"

# Zaten ayakta mi? Oyleyse ikinci bir sunucu baslatmaya calisip
# \"Address already in use\" ile olmek yerine sadece sekmeyi ac.
if /usr/bin/curl -s -o /dev/null -m 2 "$URL"; then
  /usr/bin/open "$URL"
  exit 0
fi

cd "$PROJECT" || die "Klasore girilemedi: $PROJECT"
exec /usr/bin/python3 serve.py "$PORT"
